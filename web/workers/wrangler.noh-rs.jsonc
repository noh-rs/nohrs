{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "noh-rs-redirect",
  "main": "noh-rs-redirect.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "noh.rs", "custom_domain": true },
    { "pattern": "www.noh.rs", "custom_domain": true }
  ]
}
