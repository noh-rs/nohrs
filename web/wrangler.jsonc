{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nohrs-web",
  "main": "workers/site.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // The Worker only needs to see `/`, where it decides a language. Every
    // other path is a prerendered file and is served without waking it.
    "run_worker_first": ["/"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "nohrs.app", "custom_domain": true },
    { "pattern": "www.nohrs.app", "custom_domain": true }
  ]
}
